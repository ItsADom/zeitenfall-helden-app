{
  "name": "helden-app",
  "private": true,
  "version": "0.1.1",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run build -w client && npm run start -w server",
    "start:secure": "cross-env SECURE_COOKIES=1 npm run start",
    "test": "npm run test -w shared",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
